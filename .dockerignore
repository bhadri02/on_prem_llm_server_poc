# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd

# ── Tests (not needed in container images) ────────────────────────────────────
tests/

# ── Kiro spec/steering files ──────────────────────────────────────────────────
.kiro/

# ── Python packaging artifacts ────────────────────────────────────────────────
*.egg-info
*.dist-info

# ── Virtual environments ──────────────────────────────────────────────────────
.venv
venv
env

# ── Test / property-test databases ───────────────────────────────────────────
.hypothesis/
.pytest_cache/

# ── Documentation / local-only files ─────────────────────────────────────────
*.md
LOCAL_DEMO_SETUP.md
POC_to_Production_Gap_Analysis.md
LAYER_WISE_IMPLEMENTATION.md
enterprise_onprem_LLM_platform_framework.md

# ── Helm / Kubernetes manifests ───────────────────────────────────────────────
llm-platform/
seed/

# ── OS / editor artefacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
