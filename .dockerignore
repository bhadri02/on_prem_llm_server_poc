# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore

# ── Python bytecode ───────────────────────────────────────────────────────────
**/__pycache__
*.pyc
*.pyo
*.pyd

# ── Python virtual environments ───────────────────────────────────────────────
.venv/
venv/
env/

# ── Python packaging artifacts ────────────────────────────────────────────────
*.egg-info/
*.dist-info/

# ── Test artifacts ────────────────────────────────────────────────────────────
tests/
.hypothesis/
.pytest_cache/
pytest.ini
# Per-service test files stay in the service directory but aren't needed in images
**/tests/
**/.pytest_cache/

# ── Node / frontend ───────────────────────────────────────────────────────────
portal_ui/node_modules/
portal_ui/dist/

# ── Kiro IDE files ────────────────────────────────────────────────────────────
.kiro/
.vscode/

# ── Helm / Kubernetes / deployment files (not needed in containers) ───────────
llm-platform/
scripts/
seed/

# ── Docs (not needed in containers) ──────────────────────────────────────────
*.md

# ── OS / editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
