# .env.prod.example
#
# Copy this to .env.prod and fill in real values before deploying:
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored — never commit real secrets. See
# docs/DEPLOYMENT.md for how to generate each value below.
#
# docker-compose.prod.yml reads this via --env-file .env.prod. Every
# variable here is a secret or an operator choice; internal service URLs
# and ports are fixed directly in docker-compose.prod.yml since they're
# determined by that file's own service names, not something to configure.

# ---------------------------------------------------------------------------
# Postgres (admin_portal's users/roles/API-keys database)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-hex_32

# ---------------------------------------------------------------------------
# Platform secrets — every one of these MUST be changed from any POC/demo
# value before this is reachable from anywhere untrusted. Generate each with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

# The shared API key clients send as X-Api-Key to api_gateway. Also seeded as
# the admin user's key inside admin_portal's DB at first startup (see
# admin_portal/db/seed.py) — the same value both places, always.
GATEWAY_API_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Service-to-service secret protecting GET /portal/keys/resolve and
# GET /portal/policy/matrix — never sent to a browser. Must be identical
# across api_gateway, intelligent_router, and admin_portal (all three read
# this same value from this file).
ADMIN_PORTAL_INTERNAL_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Protects audit_store's POST /audit/events from anything that isn't
# security_layer/intelligent_router. Must match across those three services
# and audit_store (all four read this same value from this file).
AUDIT_API_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Protects model_registry's internal /models/{name}/secret endpoint (and its
# write endpoints) from anything that isn't admin_portal/inference_adapter.
REGISTRY_API_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Encrypts cloud-model provider API keys at rest in model_registry's
# models.json (Fernet/AES). Must be a 32-byte url-safe base64 key — generate
# with: openssl rand -base64 32 | tr '+/' '-_'
# Losing this key makes any already-stored provider keys unrecoverable, so
# back it up alongside your other deploy secrets, not just in this file.
REGISTRY_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_-base64_32_then_tr_+/_-_

# Initial password for the seeded "admin" user (username: admin) in the
# Portal UI login screen. Change this value, then ALSO change the password
# from inside the running app on first login — this only sets the seed
# value used the very first time the DB is created.
SEED_ADMIN_PASSWORD=CHANGE_ME_pick_a_real_password

# ---------------------------------------------------------------------------
# Ollama models to pull on first startup (space-separated for EXTRA_MODELS)
# ---------------------------------------------------------------------------
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_EXTRA_MODELS=qwen2.5:3b

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Marks the admin_portal session cookie Secure (HTTPS-only). Leave false
# until a TLS-terminating reverse proxy actually fronts this deployment —
# browsers silently drop Secure cookies sent over plain HTTP, which would
# otherwise lock everyone out of the login screen.
# SESSION_COOKIE_SECURE=true

# Audit trail retention — audit.db grows forever by default (no automatic
# purge). Set a real value once you have a compliance-driven retention
# policy; 0 (default) means keep everything indefinitely.
# AUDIT_RETENTION_DAYS=90

# Distributed tracing (Jaeger, bundled in docker-compose.prod.yml) — on by
# default. Every service gracefully no-ops if tracing is disabled or the
# jaeger container isn't reachable, so this is safe to leave on; set to
# false to skip running the jaeger container's resource footprint entirely.
# TRACING_ENABLED=false
# Rate limiting is per-API-key only (each key's own rate_limit_rpm, set via
# the admin UI when issuing/editing a key — defaults to 60 if left unset at
# creation) — there is no platform-wide request-count setting anymore. This
# is the only rate-limit knob left here: the shared window length every
# key's "requests per minute" is measured against. Defaults to 60s if unset.
# RATE_LIMIT_WINDOW_SECONDS=60

# Host port the portal-ui (web UI) container binds to. Defaults well above
# 10000 deliberately — api-gateway (:8080) and admin-portal (:8084) are this
# stack's two "main" services and stay on those fixed, well-known ports;
# portal-ui isn't, so it defaults out of the way of whatever else common
# ports might already be in use on a shared on-prem server. There is no
# in-stack reverse proxy/nginx — front these three published ports with
# whatever reverse proxy already runs on this server; see
# docs/DEPLOYMENT.md's "Fronting with your own existing nginx" section.
# NOTE: do not set this to 10080 — Chrome/Edge hardcode it on their
# restricted-ports list (ERR_UNSAFE_PORT) and will refuse to load it directly,
# which matters if anyone ever browses to this port without a reverse proxy.
# PORTAL_UI_PORT=18080
