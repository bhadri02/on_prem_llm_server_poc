# .env.prod.example
#
# Copy this to .env.prod and fill in real values before deploying:
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored — never commit real secrets. See
# docs/DEPLOYMENT.md for how to generate each value below.
#
# docker-compose.prod.yml reads this via --env-file .env.prod. Every
# variable here is a secret or an operator choice; internal service URLs
# and ports are fixed directly in docker-compose.prod.yml since they're
# determined by that file's own service names, not something to configure.

# ---------------------------------------------------------------------------
# Postgres (admin_portal's users/roles/API-keys database)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-hex_32

# ---------------------------------------------------------------------------
# Platform secrets — every one of these MUST be changed from any POC/demo
# value before this is reachable from anywhere untrusted. Generate each with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

# The shared API key clients send as X-Api-Key to api_gateway. Also seeded as
# the admin user's key inside admin_portal's DB at first startup (see
# admin_portal/db/seed.py) — the same value both places, always.
GATEWAY_API_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Service-to-service secret protecting GET /portal/keys/resolve and
# GET /portal/policy/matrix — never sent to a browser. Must be identical
# across api_gateway, intelligent_router, and admin_portal (all three read
# this same value from this file).
ADMIN_PORTAL_INTERNAL_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Protects audit_store's POST /audit/events from anything that isn't
# security_layer/intelligent_router. Must match across those three services
# and audit_store (all four read this same value from this file).
AUDIT_API_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Protects model_registry's internal /models/{name}/secret endpoint (and its
# write endpoints) from anything that isn't admin_portal/inference_adapter.
REGISTRY_API_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Initial password for the seeded "admin" user (username: admin) in the
# Portal UI login screen. Change this value, then ALSO change the password
# from inside the running app on first login — this only sets the seed
# value used the very first time the DB is created.
SEED_ADMIN_PASSWORD=CHANGE_ME_pick_a_real_password

# ---------------------------------------------------------------------------
# Ollama models to pull on first startup (space-separated for EXTRA_MODELS)
# ---------------------------------------------------------------------------
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_EXTRA_MODELS=qwen2.5:3b

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Requests allowed per API key per window at api_gateway. Defaults (60/60s)
# if unset — only set these if you need something different in production.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# Host port the portal-ui container (the platform's single front door) binds
# to. Change if 80 is already in use on the server.
# PORTAL_UI_PORT=80
