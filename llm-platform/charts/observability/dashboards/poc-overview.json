{
  "title": "LLM Platform POC Overview",
  "uid": "llm-platform-poc-overview",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 36,
  "version": 1,
  "timezone": "utc",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(llm_api_gateway_requests_total[1m])",
          "legendFormat": "api_gateway",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_api_gateway_requests_total{status=\"error\"}[1m]) + rate(llm_security_requests_total{status=\"error\"}[1m]) + rate(llm_router_requests_total{status=\"error\"}[1m]) + rate(llm_cache_requests_total{status=\"error\"}[1m]) + rate(llm_inference_requests_total{status=\"error\"}[1m]) + rate(llm_agent_requests_total{status=\"error\"}[1m]))",
          "legendFormat": "total errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "End-to-End Latency P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_api_gateway_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "api_gateway",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_security_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "security",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_router_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "router",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_cache_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "cache",
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_inference_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "inference",
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_agent_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "agent",
          "refId": "F"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(llm_cache_requests_total{outcome=\"hit\"}[1m]) / rate(llm_cache_requests_total[1m])",
          "legendFormat": "cache hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Security Blocks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(llm_security_requests_total{outcome=\"block\"}[1m])",
          "legendFormat": "security blocks",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Inference Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(llm_inference_requests_total[1m])",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active Agent Sessions",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "llm_agent_requests_total",
          "legendFormat": "agent sessions",
          "refId": "A"
        }
      ]
    }
  ]
}
