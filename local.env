# ============================================================
# Local development environment variables
# All services read from this file via run-local.ps1
# ============================================================

# --- Shared ---
AUDIT_API_KEY=poc-audit-key
LOG_LEVEL=INFO

# --- API Gateway (port 8080) ---
GATEWAY_API_KEY=poc-secret-key
DOWNSTREAM_SECURITY_URL=http://localhost:8081
DOWNSTREAM_TIMEOUT_SECONDS=120
# Identity resolution (Phase 2 — RBAC + per-user API keys). Must match the
# Admin Portal's ADMIN_PORTAL_INTERNAL_KEY below.
ADMIN_PORTAL_URL=http://localhost:8084
ADMIN_PORTAL_INTERNAL_KEY=poc-portal-internal-key
KEY_CACHE_TTL_SECONDS=30

# --- Security Layer (port 8081) ---
DOWNSTREAM_ROUTER_URL=http://localhost:8082
AUDIT_STORE_URL=http://localhost:9200
INJECTION_PATTERNS_PATH=injection_patterns.yaml
PII_ENABLED=true

# --- Intelligent Router (port 8082) ---
MODEL_MATRIX_PATH=model_matrix.yaml
TASK_RULES_PATH=task_classifier_rules.yaml
POLICY_MATRIX_PATH=policy_matrix.yaml
CACHE_URL=http://localhost:8086
INFERENCE_ADAPTER_URL=http://localhost:8087
INFERENCE_TIMEOUT_SECONDS=120

# --- Agent Framework (port 8083) ---
ROUTER_URL=http://localhost:8082
TOOL_CATALOG_PATH=tools/catalog.yaml
MAX_AGENT_STEPS=10

# --- Inference Adapter (port 8087) ---
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# --- Cache Service (port 8086) ---
REDIS_URL=redis://localhost:6379
SIMILARITY_THRESHOLD=0.90
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Forces the embedding model to load from the local HuggingFace cache only —
# no network call to the Hub on startup (this platform must run air-gapped).
# The model must already be cached once (first run with internet, or baked
# into the image) — same "fetch once, run offline forever after" pattern as
# `ollama pull`. Set to 0 only if you need to let it fetch/update for real.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# METRICS_PORT is set per-service by run-local.ps1 to avoid port collisions:
#   inference_adapter → 9090, cache_service → 9091, agent_framework → 9092

# --- Audit Store (port 9200) ---
DB_PATH=./audit.db

# --- Model Registry (port 5001 — port 5000 occupied by Docker Desktop) ---
STORAGE_PATH=./models.json
REGISTRY_API_KEY=poc-registry-key

# --- Admin Portal (port 8084) ---
API_GATEWAY_URL=http://localhost:8080
MODEL_REGISTRY_URL=http://localhost:5001
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
# Users/roles/API-keys DB (Phase 1). Override in local.env.local for a real
# external Postgres instead of the local docker-compose one.
DATABASE_URL=postgresql://llm_user:llm_pass@localhost:5432/llm_platform
ADMIN_PORTAL_INTERNAL_KEY=poc-portal-internal-key
